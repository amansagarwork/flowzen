// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(cuid())
  username            String?  @unique
  email               String   @unique
  password            String?
  authProvider        String   @default("local")
  googleSub           String?  @unique
  avatarUrl           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  onboardingCompleted Boolean  @default(false)
  projectInterests    String[] @default([])
  githubAccessToken   String?
  githubUsername      String?
  projects            Project[] // Relation to Projects

  @@map("users")
}

model Project {
  id             String   @id @default(cuid())
  name           String
  description    String?
  status         String   @default("Active") // 'Active', 'Archived', 'Completed'
  health         String   @default("Healthy") // 'Healthy', 'At Risk', 'Failing'
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  lastAccessedAt DateTime @default(now())
  currentVersion String   @default("v1")
  githubRepo     String?
  githubConnected Boolean @default(false)
  createdAt      DateTime @default(now())
  // CI/CD Configuration
  jenkinsJob     String?
  jenkinsUser    String?
  jenkinsToken   String? // Encrypt in production
  jenkinsUrl     String?
  scanMode       String   @default("JENKINS") // JENKINS or NATIVE
  updatedAt      DateTime @updatedAt
  analyticsEvents AnalyticsEvent[]
  codeQualityReports CodeQualityReport[]

  @@map("projects")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String
  method    String
  status    Int
  latency   Int
  userAgent String?
  region    String?  @default("US")
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@map("analytics_events")
}

model CodeQualityReport {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  score     Int      // 0-100 (Maintainability Rating)
  rating    String   // "A", "B", "C", "D", "E"
  
  // Issues Breakdown
  critical  Int      // "Blocked"
  high      Int
  medium    Int
  low       Int
  
  // SonarQube Metrics
  coverage      Float    // % Code Coverage
  duplications  Float    // % Duplicated Lines
  vulnerabilities Int
  codeSmells    Int
  
  gateStatus String   // "PASSED", "FAILED"
  buildUrl   String?
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
  @@map("quality_reports")
}
