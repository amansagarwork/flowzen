// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(cuid())
  username            String?  @unique
  email               String   @unique
  password            String?
  authProvider        String   @default("local")
  googleSub           String?  @unique
  avatarUrl           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  onboardingCompleted Boolean  @default(false)
  projectInterests    String[] @default([])
  githubAccessToken   String?
  githubUsername      String?
  projects            Project[] // Relation to Projects

  @@map("users")
}

model Project {
  id             String   @id @default(cuid())
  name           String
  description    String?
  status         String   @default("Active") // 'Active', 'Archived', 'Completed'
  health         String   @default("Healthy") // 'Healthy', 'At Risk', 'Failing'
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  lastAccessedAt DateTime @default(now())
  currentVersion String   @default("v1")
  githubRepo     String?
  githubConnected Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("projects")
}
